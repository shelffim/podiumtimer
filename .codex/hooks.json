{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/stop-check.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if grep -qiE 'rm\\s+-[a-z]*(r[a-z]*f|f[a-z]*r)|git\\s+push(\\s.*)?\\s(-f|--force)|git\\s+reset\\s+--hard|git\\s+clean\\s+-[a-z]*f|drop\\s+table'; then echo 'BLOCKED: 위험한 명령어가 감지되었습니다.' >&2; exit 2; fi"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/tdd-guard.sh\""
          }
        ]
      }
    ]
  }
}
